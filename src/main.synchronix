phi main_emb_self_hosted = (2 * 100) == 200
phi main_pipeline_ok     = (1 + 1 + 1) == 3

func sx_parse_dec_cstr(s: Int) -> Int {
    if s == 0 { return 0 }
    var i = 0
    var acc = 0
    var keep = 1
    while keep != 0 {
        let ch = sx_ptr_read8(s + i)
        if ch >= 48 && ch <= 57 {
            acc = acc * 10 + (ch - 48)
            i = i + 1
        } else {
            keep = 0
        }
    }
    return acc
}

func sx_print_version() -> Int {
    println("synchronix-embedded 2.0.0 (self-hosted-pure-synchronix; targets: cortex-m4, arm64-bare, x86_64-bare, x86_64, llvm-ir)")
    return 0
}

func sx_print_banner() -> Int {
    println("SYNCHRONIX EMBEDDED v2.0.0 — Bare-Metal Native Language (100% Pure Synchronix)")
    println("Full V2 Parity: Static-Pool ARC+GC + RTOS Fibers + Phi Formal Logic + Volatile MMIO")
    println("")
    println("Usage:")
    println("  synchronix_emb compile <file.synchronix> [-o out]")
    println("                         [--target cortex-m|arm64|x86_64-bare|x86_64|llvm]")
    println("                         [--bare] [--noalloc] [--flash-kb N] [--sram-kb N]")
    println("                         [--emit-llvm] [--emit-asm] [--dump-ast] [--dump-ir]")
    println("                         [--link <ext.a|.lib>] [-g]")
    println("  synchronix_emb run [file.synchronix]     Build & run host-simulated firmware")
    println("  synchronix_emb new <firmware_name>       Scaffold embedded firmware + memory.ld")
    println("  synchronix_emb build [file.synchronix]   Build Synchronix embedded package")
    println("  synchronix_emb test [file.synchronix]    Run Phi verification & firmware tests")
    println("  synchronix_emb size <file.elf|file.o>    Inspect Flash/SRAM section sizes")
    println("  synchronix_emb fmt <file.synchronix>     Format .synchronix source canonically")
    println("  synchronix_emb lint <file.synchronix>    Run static Phi & embedded safety linter")
    println("  synchronix_emb lsp                       Start Synchronix Embedded LSP server")
    println("  synchronix_emb debug <file.synchronix>   Compile with DWARF -g & launch LLDB")
    println("  synchronix_emb profile <file.synchronix> Profile 3-phase compiler & SRAM budget")
    println("  synchronix_emb --self-test               Run embedded static-pool self-test")
    println("  synchronix_emb --version                 Show version & bare-metal targets")
    return 0
}

// ----------------------------------------------------------------------------
// Embedded V2 Parity Self-Hosted Runtime Verification (--self-test)
// ----------------------------------------------------------------------------
async func sx_emb_async_check(seed: Int) -> Int {
    let scaled = std_apply_scale(seed, 3)
    return scaled + 10
}

func sx_emb_self_test() -> Int {
    println("=== SYNCHRONIX EMBEDDED v2.0.0 SELF-HOSTED RUNTIME VERIFICATION ===")

    let arc_box = arc(42)
    let arc_alias = arc_box
    val gc_box = gc(100)
    print("  1. Native ARC + GC   : "); println(arc_alias + gc_box)

    let owned_v = 77
    let borrowed_v = borrow owned_v
    print("  2. Borrowed value    : "); println(borrowed_v)

    let factor = 4
    let mult = lambda (x: Int) => x * factor
    let piped = 12 |> mult
    print("  3. Lambda 12|>mult   : "); println(piped)

    prove (6 * 7) == 42
    prove (1073872896 % 4) == 0

    let g = std_identity<Int>(99)
    let f5 = std_factorial(5)
    print("  4. Generic + 5!      : "); println(g + f5)

    let t1 = spawn sx_emb_async_check(5)
    let t2 = spawn sx_emb_async_check(7)
    let r1 = await t1
    let r2 = await t2
    print("  5. M:N Async Fibers  : "); println(r1 + r2)

    // Embedded Deterministic Static-Pool ARC + Bounded-Pause GC + Bump Arena
    let rt_mem = sx2_mem_init()
    let a_pos = sx2_arena_alloc(rt_mem, 16)
    let a_obj = sx2_arc_box_int(rt_mem, 512)
    sx2_arc_retain(rt_mem, a_obj)
    let a_val = sx2_arc_unbox_int(a_obj)
    sx2_arc_release(rt_mem, a_obj)
    sx2_arc_release(rt_mem, a_obj)

    let g_obj = sx2_gc_box_int(rt_mem, 1024)
    sx2_gc_push_root(rt_mem, g_obj)
    let g_val = sx2_gc_unbox_int(g_obj)
    sx2_gc_pop_root(rt_mem)
    let swept = sx2_gc_collect(rt_mem)
    print("  6. Static Slab ARC+GC: "); println(a_val + g_val + swept + a_pos)
    sx2_mem_stats(rt_mem)

    // Embedded Priority-Aware Bounded RTOS Fiber Scheduler
    let sch = sx2_sched_init()
    let ft1 = sx2_spawn_prio(sch, 1, 5, 2)
    let ft2 = sx2_spawn_prio(sch, 3, 200, 5)
    let fr1 = sx2_await(sch, ft1)
    let fr2 = sx2_await(sch, ft2)
    print("  7. RTOS Prio Sched   : "); println(fr1 + fr2)
    sx2_sched_stats(sch)

    // Freestanding Phi Runtime & Static-Pool Closures
    let prt = sx2_phi_rt_init()
    sx2_phi_check(prt, 1, 100)
    let cl = sx2_closure_alloc(prt, 1, 1)
    sx2_closure_set_env(cl, 0, 3)
    let cl_res = sx2_closure_call1(cl, 14)
    print("  8. Static Closure    : "); println(cl_res)
    sx2_phi_stats(prt)

    // Embedded DSP (Q16.16 Fixed-Point), CRC-8, Bitfields & Ring Buffer FIFO
    let q_a = std_q16_from_int(7)
    let q_b = std_q16_from_int(6)
    let q_p = std_q16_to_int(std_q16_mul(q_a, q_b))
    let bits = std_popcount(std_bit_set(std_bit_set(0, 0), 3))
    let crc = std_crc8_step(0, 65)
    let rb = std_ring_init(8)
    std_ring_push(rb, 10)
    std_ring_push(rb, 20)
    let p0 = std_ring_pop(rb)
    let p1 = std_ring_pop(rb)
    print("  9. Embedded DSP+FIFO : q16="); print(q_p)
    print(" bits="); print(bits)
    print(" crc8="); print(crc)
    print(" fifo="); println(p0 + p1)

    gc_collect()
    mem_stats()
    return 0
}

// ----------------------------------------------------------------------------
// Compile Subcommand Flag Parser
// ----------------------------------------------------------------------------
func sx_apply_target_flag(ctx: Int, targ: Int) -> Int {
    if sx_cstr_eq(targ, "cortex-m") != 0 || sx_cstr_eq(targ, "cortex-m4") != 0 || sx_cstr_eq(targ, "thumb") != 0 {
        sx_ctx_set(ctx, CTX_OPT_TARGET(), TARGET_CORTEX_M())
        return 0
    }
    if sx_cstr_eq(targ, "arm64") != 0 || sx_cstr_eq(targ, "aarch64") != 0 {
        sx_ctx_set(ctx, CTX_OPT_TARGET(), TARGET_ARM64())
        return 0
    }
    if sx_cstr_eq(targ, "x86_64-bare") != 0 || sx_cstr_eq(targ, "x64-bare") != 0 {
        sx_ctx_set(ctx, CTX_OPT_TARGET(), TARGET_X86_64_BARE())
        return 0
    }
    if sx_cstr_eq(targ, "llvm") != 0 {
        sx_ctx_set(ctx, CTX_OPT_TARGET(), TARGET_LLVM_IR())
        return 0
    }
    sx_ctx_set(ctx, CTX_OPT_TARGET(), TARGET_X86_64())
    return 0
}

func sx_cli_compile(ctx: Int, argc: Int, argv: Int, start_idx: Int) -> Int {
    var src_file = 0
    var out_file = "a.exe"
    var i = start_idx

    while i < argc {
        let arg = sx_argv_get(argv, i)
        var handled = 0

        if sx_cstr_eq(arg, "-o") != 0 {
            i = i + 1
            if i < argc { out_file = sx_argv_get(argv, i) }
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "--target") != 0 {
            i = i + 1
            if i < argc {
                let targ = sx_argv_get(argv, i)
                sx_apply_target_flag(ctx, targ)
            }
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "--bare") != 0 {
            sx_ctx_set(ctx, CTX_OPT_BARE(), 1)
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "--noalloc") != 0 {
            sx_ctx_set(ctx, CTX_OPT_NOALLOC(), 1)
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "--flash-kb") != 0 {
            i = i + 1
            if i < argc {
                let fkb = sx_parse_dec_cstr(sx_argv_get(argv, i))
                sx_ctx_set(ctx, CTX_OPT_FLASH_KB(), fkb)
            }
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "--sram-kb") != 0 {
            i = i + 1
            if i < argc {
                let skb = sx_parse_dec_cstr(sx_argv_get(argv, i))
                sx_ctx_set(ctx, CTX_OPT_SRAM_KB(), skb)
            }
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "--emit-llvm") != 0 {
            sx_ctx_set(ctx, CTX_OPT_TARGET(), TARGET_LLVM_IR())
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "--emit-asm") != 0 {
            sx_ctx_set(ctx, CTX_OPT_EMIT_ASM(), 1)
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "--dump-ast") != 0 {
            sx_ctx_set(ctx, CTX_OPT_DUMP_AST(), 1)
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "--dump-ir") != 0 {
            sx_ctx_set(ctx, CTX_OPT_DUMP_IR(), 1)
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "--link") != 0 {
            i = i + 1
            if i < argc {
                let ext = sx_argv_get(argv, i)
                sx_ctx_set(ctx, CTX_OPT_EXT_LIB(), ext)
            }
            handled = 1
        }
        if handled == 0 && sx_cstr_eq(arg, "-g") != 0 {
            sx_ctx_set(ctx, CTX_OPT_DEBUG(), 1)
            handled = 1
        }
        if handled == 0 {
            src_file = arg
        }
        i = i + 1
    }

    if src_file == 0 {
        println("[Synchronix Embedded] Error: missing required file or argument.")
        return 1
    }
    let rc = sx_compile_file(ctx, src_file, out_file)
    return rc
}

// ----------------------------------------------------------------------------
// Subcommand Dispatcher
// ----------------------------------------------------------------------------
func sx_cli_dispatch(ctx: Int, argc: Int, argv: Int) -> Int {
    let cmd = sx_argv_get(argv, 1)

    if sx_cstr_eq(cmd, "--version") != 0 { sx_print_version(); return 0 }
    if sx_cstr_eq(cmd, "--help") != 0 || sx_cstr_eq(cmd, "-h") != 0 { sx_print_banner(); return 0 }
    if sx_cstr_eq(cmd, "--self-test") != 0 { return sx_emb_self_test() }
    if sx_cstr_eq(cmd, "lsp") != 0 { return sx_cmd_lsp() }

    if sx_cstr_eq(cmd, "new") != 0 {
        if argc < 3 { println("[Synchronix Embedded] Error: missing project name."); return 1 }
        return sx_cmd_new(sx_argv_get(argv, 2))
    }
    if sx_cstr_eq(cmd, "size") != 0 {
        if argc < 3 { println("[Synchronix Embedded] Error: missing binary path."); return 1 }
        return sx_cmd_size(sx_argv_get(argv, 2))
    }
    if sx_cstr_eq(cmd, "fmt") != 0 {
        if argc < 3 { println("[Synchronix Embedded] Error: missing file path."); return 1 }
        return sx_cmd_fmt(ctx, sx_argv_get(argv, 2))
    }
    if sx_cstr_eq(cmd, "lint") != 0 {
        if argc < 3 { println("[Synchronix Embedded] Error: missing file path."); return 1 }
        return sx_cmd_lint(ctx, sx_argv_get(argv, 2))
    }
    if sx_cstr_eq(cmd, "debug") != 0 {
        if argc < 3 { println("[Synchronix Embedded] Error: missing file path."); return 1 }
        return sx_cmd_debug(ctx, sx_argv_get(argv, 2))
    }
    if sx_cstr_eq(cmd, "profile") != 0 {
        if argc < 3 { println("[Synchronix Embedded] Error: missing file path."); return 1 }
        return sx_cmd_profile(ctx, sx_argv_get(argv, 2))
    }
    if sx_cstr_eq(cmd, "run") != 0 {
        var rsrc = 0
        if argc >= 3 { rsrc = sx_argv_get(argv, 2) }
        return sx_cmd_run(ctx, rsrc)
    }
    if sx_cstr_eq(cmd, "test") != 0 {
        var tsrc = 0
        if argc >= 3 { tsrc = sx_argv_get(argv, 2) }
        return sx_cmd_test(ctx, tsrc)
    }
    if sx_cstr_eq(cmd, "build") != 0 {
        var bsrc = 0
        if argc >= 3 { bsrc = sx_argv_get(argv, 2) }
        return sx_cmd_build(ctx, bsrc, 0)
    }
    if sx_cstr_eq(cmd, "compile") != 0 {
        return sx_cli_compile(ctx, argc, argv, 2)
    }
    return sx_cli_compile(ctx, argc, argv, 1)
}

func main(argc: Int, argv: Int) -> Int {
    if argc < 2 {
        sx_print_banner()
        return 0
    }
    let ctx = sx_ctx_create()
    let rc = sx_cli_dispatch(ctx, argc, argv)
    sx_ctx_destroy(ctx)
    return rc
}
