// ============================================================================
// SYNCHRONIX EMBEDDED v2.0.0 — Foundation: Freestanding Phi & Static Closures
// (src/runtime/phi_lambda_rt.synchronix)
// ============================================================================
// Pure Synchronix Embedded Runtime for:
//   - Freestanding Phi Formal Logic Fault Handler (records fault line & count
//     cleanly without requiring OS exit() or printf() on bare-metal MCUs)
//   - Static-Pool Lambda Closure Allocator (32 pre-allocated closure slots)
// ============================================================================

import sx_defs
import utils

phi phi_rt_env_header = 2 == 2
phi phi_rt_pool_cap   = 32 > 0

func PRT_CHECKS()     -> Int { return 0 }
func PRT_PASSED()     -> Int { return 1 }
func PRT_CLOSURES()   -> Int { return 2 }
func PRT_FAULTS()     -> Int { return 3 }
func PRT_LAST_LINE()  -> Int { return 4 }
func PRT_CLOS_POOL()  -> Int { return 5 }

func sx2_phi_rt_init() -> Int {
    let prt = sx_buf_new(8)
    let cpool = sx_buf_new(EMB_CLOS_POOL_CAP())
    var i = 0
    while i < EMB_CLOS_POOL_CAP() {
        let slot = sx_buf_new(6)
        sx_buf_set(cpool, i, slot)
        i = i + 1
    }
    sx_buf_set(prt, PRT_CHECKS(), 0)
    sx_buf_set(prt, PRT_PASSED(), 0)
    sx_buf_set(prt, PRT_CLOSURES(), 0)
    sx_buf_set(prt, PRT_FAULTS(), 0)
    sx_buf_set(prt, PRT_LAST_LINE(), 0)
    sx_buf_set(prt, PRT_CLOS_POOL(), cpool)
    return prt
}

func sx2_phi_check(prt: Int, cond: Int, line: Int) -> Int {
    let chk = sx_buf_get(prt, PRT_CHECKS())
    sx_buf_set(prt, PRT_CHECKS(), chk + 1)
    if cond == 0 {
        let flt = sx_buf_get(prt, PRT_FAULTS())
        sx_buf_set(prt, PRT_FAULTS(), flt + 1)
        sx_buf_set(prt, PRT_LAST_LINE(), line)
        print("[Synchronix Embedded Phi Fault] Contract violation trapped at line ")
        println(line)
        return 0
    }
    let ok = sx_buf_get(prt, PRT_PASSED())
    sx_buf_set(prt, PRT_PASSED(), ok + 1)
    return 1
}

func sx2_phi_stats(prt: Int) -> Int {
    let chk = sx_buf_get(prt, PRT_CHECKS())
    let ok = sx_buf_get(prt, PRT_PASSED())
    let cl = sx_buf_get(prt, PRT_CLOSURES())
    let flt = sx_buf_get(prt, PRT_FAULTS())
    print("  Phi Runtime : dynamic_checks="); print(chk)
    print(" passed="); print(ok)
    print(" faults="); print(flt)
    print(" static_closures="); print(cl); println("/32")
    return 0
}

// ----------------------------------------------------------------------------
// Static-Pool Lambda Closure Objects: [0]=fn_id, [1]=env_cnt, [2+i]=env[i]
// ----------------------------------------------------------------------------
func sx2_closure_alloc(prt: Int, fn_id: Int, env_cnt: Int) -> Int
    requires env_cnt >= 0
{
    let cnt = sx_buf_get(prt, PRT_CLOSURES())
    if cnt >= EMB_CLOS_POOL_CAP() {
        return 0
    }
    let cpool = sx_buf_get(prt, PRT_CLOS_POOL())
    let cl = sx_buf_get(cpool, cnt)
    sx_buf_set(cl, 0, fn_id)
    sx_buf_set(cl, 1, env_cnt)
    sx_buf_set(prt, PRT_CLOSURES(), cnt + 1)
    return cl
}

func sx2_closure_set_env(cl: Int, idx: Int, value: Int) -> Int
    requires idx >= 0
{
    if cl == 0 { return 0 }
    sx_buf_set(cl, 2 + idx, value)
    return value
}

func sx2_closure_get_env(cl: Int, idx: Int) -> Int
    requires idx >= 0
{
    if cl == 0 { return 0 }
    let v = sx_buf_get(cl, 2 + idx)
    return v
}

func sx2_closure_call1(cl: Int, arg0: Int) -> Int {
    if cl == 0 { return 0 }
    let fn_id = sx_buf_get(cl, 0)
    let cap0 = sx_buf_get(cl, 2)
    if fn_id == 1 {
        return arg0 * cap0
    }
    if fn_id == 2 {
        return arg0 + cap0
    }
    return arg0
}
